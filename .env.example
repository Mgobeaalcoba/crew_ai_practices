# Copiá este archivo a .env y completá lo que uses. .env está en .gitignore: no lo subas.

# ── LLM ──────────────────────────────────────────────────────────────────────────────
# Proveedor: groq (por defecto) | lmstudio | ollama | openai | anthropic | gemini
# LLM_PROVEEDOR=groq
# Modelo. Opcional si el proveedor tiene uno por defecto (groq: qwen/qwen3.8-27b, ollama: qwen3:8b,
# anthropic: claude-haiku-4-5). Obligatorio para lmstudio, openai y gemini.
# LLM_MODELO=
# Tope de tokens de salida por respuesta. Groq usa 900 por defecto (ver docs/decisiones-tecnicas.md).
# LLM_MAX_TOKENS=

# Keys: solo la del proveedor que uses.
# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Nombres de la primera versión del repo (siguen funcionando cuando el proveedor es groq):
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MAX_TOKENS=900

# ── Embeddings (knowledge y memoria) ─────────────────────────────────────────────────
# lmstudio (por defecto, local) | ollama (local) | openai (usa OPENAI_API_KEY)
# EMBEDDINGS_PROVEEDOR=lmstudio
# EMBEDDINGS_MODELO=text-embedding-nomic-embed-text-v1.5

# ── Otros ────────────────────────────────────────────────────────────────────────────
# Imagen de Docker para el sandbox de ejecución de código (ejemplos/01_agentes/09_ejecucion_de_codigo)
# SANDBOX_IMAGEN=python:3.12-slim
# Activa los tests que llaman a un LLM real (gastan tokens)
# CREW_VIVO=1
